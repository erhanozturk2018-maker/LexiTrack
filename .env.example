# LexiTrack — local secrets.
#
# Copy this file to `.env` (in this folder, or in the data folder) and fill
# it in. `.env` is ignored by git and is never copied into backups; the token
# is never stored in the database.

# The token BotFather gave you, e.g. 123456789:AAH...  Leave empty to run
# without Telegram.
LEXITRACK_TELEGRAM_TOKEN=

# Optional. Your numeric Telegram chat id. Leave empty and the first chat
# that sends /start to the bot becomes its owner; every other chat is ignored.
LEXITRACK_TELEGRAM_CHAT_ID=
